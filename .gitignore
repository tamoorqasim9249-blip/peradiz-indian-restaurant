# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets, but .env.example (placeholders only, see CLAUDE.md §15)
# must be committed as the documented template.
.env*
!.env.example

# vercel
.vercel

# local tooling config (machine-specific absolute paths, e.g. dev-server launch config)
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
