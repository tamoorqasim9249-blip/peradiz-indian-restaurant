# Copy this file to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL connection string (Prisma) — see README.md "Environment Setup"
DATABASE_URL="postgresql://user:password@localhost:5432/peradiz"

# Server-only Anthropic API key for the AI chatbot (/api/chat). Get one at
# https://console.anthropic.com/ — never expose this in client-side code.
ANTHROPIC_API_KEY=""

# Canonical site origin, used for metadata/OG/sitemap absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Browser-exposed, RESTRICTED Google Maps key (Maps JavaScript API only). Optional — the
# location section falls back to a free, keyless map embed when this is unset. Before setting
# a real value, create the key in Google Cloud Console and restrict it: API restriction to
# "Maps JavaScript API" only, application restriction to this site's HTTP referrers
# (localhost:3000/* for dev, the real domain for production), and use a separate key per
# environment. See README.md "Google Maps" for the full steps. This key is intentionally
# client-visible by design (NEXT_PUBLIC_*) — restriction, not secrecy, is its security
# boundary. Never put a server secret (ANTHROPIC_API_KEY, DATABASE_URL) in a NEXT_PUBLIC_* var.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
